syntax = "v1"

info(
	title: "用户中心服务"
	desc: "用户中心服务"
	author: "ZaiNeng"
	version: "v1"
)

type (
	UserInfoResp {
		Id           uint   `json:"id"`
		Name         string `json:"name"`
		Mobile       string `json:"mobile"`
		Avatar       string `json:"avatar"`
		Sex          int    `json:"sex"`
		ActiveStatus int    `json:"active_status"`
		ItemID       int64  `json:"item_id"`
		Status       int    `json:"status"`
	}

	UserInfoReq {
		UserId int64 `form:"user_id"`
	}

	modifyNameReq {
		Name   string `json:"name"`
	}

	wearingBadgeReq {
		BadgeId int64 `json:"badge_id"`
	}
)

@server(
	prefix: capi/user
	group: user
	middleware: Auth  // 需要认证的接口单独一组
)
service mallchatgo {
	@doc "用户详情"
	@handler userInfo
	get /userInfo (UserInfoReq) returns (UserInfoResp)

	@doc "修改用户名"
	@handler modifyName
	put /name (modifyNameReq) returns ()

	@doc "佩戴徽章"
	@handler wearingBadge
	put /badge (wearingBadgeReq) returns ()
}