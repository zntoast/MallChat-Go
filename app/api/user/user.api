syntax = "v1"

info(
	title: "用户中心服务"
	desc: "用户中心服务"
	author: "ZaiNeng"
	version: "v1"
)

type (
	 UserInfoResp {
		id int64
		username string
		mobile string
	}

	UserInfoReq {
		uid string
	}
)

@server(
	prefix: capi/user
	group: user
	middleware: Auth  // 需要认证的接口单独一组
)
service mallchatgo {
	@doc "用户详情"
	@handler userInfo
	get /userInfo (UserInfoReq) returns (UserInfoResp)
}
