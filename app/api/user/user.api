syntax = "v1"

info(
	title: "用户中心服务"
	desc: "用户中心服务"
	author: "ZaiNeng"
	version: "v1"
)

type (
	UserInfoResp {
		Id           uint   `json:"id"`            // 用户ID
		Name         string `json:"name"`          // 用户名
		Mobile       string `json:"mobile"`        // 手机号
		Avatar       string `json:"avatar"`        // 头像URL
		Sex          int    `json:"sex"`           // 性别 0-未知 1-男 2-女
		ActiveStatus int    `json:"active_status"` // 活跃状态
		ItemID       int64  `json:"item_id"`       // 当前佩戴物品ID
		Status       int    `json:"status"`        // 用户状态
	}

	UserInfoReq {
		UserId int64 `form:"user_id"` // 用户ID
	}

	ModifyNameReq {
		Name string `json:"name"` // 新用户名
	}

	WearingBadgeReq {
		BadgeId int64 `json:"badge_id"` // 徽章ID
	}

	BadgesReq {
		Uid int64 `json:"uid"` // 用户ID
	}

	BadgesItem {
		Id       int64  `json:"id"`       // 徽章ID
		Img      string `json:"img"`      // 徽章图片URL
		Describe string `json:"describe"` // 徽章描述
		Obtain   int64  `json:"obtain"`   // 是否拥有 0-未拥有 1-已拥有
		Wearing  int64  `json:"wearing"`  // 是否佩戴 0-未佩戴 1-已佩戴
	}

	BadgesItemsResp {
		Items []BadgesItem `json:"items"` // 徽章列表
	}
)

@server(
	prefix: capi/user
	group: user
	middleware: Auth  // 需要认证的接口单独一组
)
service mallchatgo {
	@doc "用户详情"
	@handler userInfo
	get /userInfo (UserInfoReq) returns (UserInfoResp)

	@doc "修改用户名"
	@handler modifyName
	put /name (ModifyNameReq) returns ()

	@doc "佩戴徽章"
	@handler wearingBadge
	put /badge (WearingBadgeReq) returns ()

	@doc "可选徽章预览"
	@handler badges
	get /badges (BadgesReq) returns (BadgesItemsResp)

}